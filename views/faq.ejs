<%- include('partials/head', { pageTitle: 'FAQ', pageStyles: 'faq.css' }) %>
<%- include('partials/header') %>

<main class="faq">
	<h1>Frequently Asked Questions</h1>
	<p class="faq__intro">Practical answers for planning your visit. If you can't find what you're looking for, get in touch on our <a href="/contact">Contact page</a>.</p>

	<div class="faq__list">
		<% faqs.forEach(function (item) { %>
			<details class="faq__item">
				<summary><%= item.question %></summary>
				<p><%= item.answer %></p>
			</details>
		<% }) %>
	</div>
</main>

<%- include('partials/footer') %>
