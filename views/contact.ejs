<%- include('partials/head', { pageTitle: 'Contact', pageStyles: 'contact.css' }) %>
<%- include('partials/header') %>

<main class="contact">
	<h1>Contact Us</h1>
	<p>Have a general question, some feedback, or something you'd like to tell the team? Send us a message below.</p>

	<% if (submitted) { %>
		<div class="contact__success" role="status">Thanks — your message has been sent. We read every one, though we can't always reply individually.</div>
	<% } %>

	<% if (error) { %>
		<div class="contact__error" role="alert"><%= error %></div>
	<% } %>

	<form id="contact-form" class="contact-form" action="/contact" method="POST" novalidate>
		<div class="form-field">
			<label for="name">Name</label>
			<input type="text" id="name" name="name" value="<%= values.name %>">
			<span class="form-error" id="name-error"></span>
		</div>

		<div class="form-field">
			<label for="email">Email</label>
			<input type="email" id="email" name="email" value="<%= values.email %>">
			<span class="form-error" id="email-error"></span>
		</div>

		<div class="form-field">
			<label for="message">Message</label>
			<textarea id="message" name="message" rows="6"><%= values.message %></textarea>
			<span class="form-error" id="message-error"></span>
		</div>

		<button type="submit" class="btn">Send message</button>
	</form>
</main>

<script src="/js/contact-validation.js"></script>
<%- include('partials/footer') %>
