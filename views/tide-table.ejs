<%- include('partials/head', { pageTitle: 'The Tide Table', pageStyles: 'tide-table.css' }) %>
<%- include('partials/header') %>

<main class="tide-table" data-tide="low">
	<h1>The Tide Table</h1>
	<p class="tide-table__intro">Our Coastal Rockpools exhibit in miniature. Twelve real rockpool residents look and behave differently depending on whether the tide is out or in — switch between them below and see why.</p>

	<div class="tide-toggle" role="group" aria-label="Choose the tide">
		<button type="button" class="tide-toggle__btn is-active" data-tide-select="low" aria-pressed="true">Low tide</button>
		<button type="button" class="tide-toggle__btn" data-tide-select="high" aria-pressed="false">High tide</button>
	</div>

	<div class="rockpool-scene">
		<% creatures.forEach(function (creature) { %>
			<article class="creature" data-creature="<%= creature.slug %>">
				<img class="creature__photo" src="/assets/creatures/<%= creature.image %>" alt="<%= creature.alt %>" loading="lazy">
				<div class="creature__body">
					<div class="creature__heading">
						<h2><%= creature.name %></h2>
						<span class="creature__badge" data-low="Sheltering" data-high="Active">Sheltering</span>
					</div>
					<p class="creature__about"><%= creature.about %></p>
					<p class="creature__caption"
						data-low="<%= creature.low %>"
						data-high="<%= creature.high %>"><%= creature.low %></p>
				</div>
			</article>
		<% }); %>
	</div>

	<section class="tide-table__note">
		<h2>Conservation note</h2>
		<p>Rockpool ecosystems are surprisingly fragile — a single misplaced footstep can destroy years of slow-growing life. Every creature here has its own way of surviving the twice-daily switch between air and water; that's part of why our real touch pools are always keeper-supervised.</p>
	</section>
</main>

<script src="/js/tide-table.js"></script>
<%- include('partials/footer') %>
