<%- include('partials/head', { pageTitle: 'Journal' , pageStyles: 'journal.css' }) %>
  <%- include('partials/header') %>

    <main class="journal" id="main-content">
      <div class="page-hero" style="background-image: url('/assets/pexels-airamdphoto-9408375.jpg');">
        <div class="page-hero__tint"></div>
        <div class="page-hero__glass">
          <h1>Aquarium World Journal</h1>
          <p class="journal__intro">Field notes, small wins and the occasional myth-busting, straight from the teams behind each zone.</p>
        </div>
      </div>
      <% posts.forEach(post=> { %>
        <article class="card journal__post">
          <% if (post.image) { %>
            <img class="journal__post-image" src="/assets/<%= post.image %>" alt="<%= post.zone_name ? post.zone_name + ' — ' : '' %><%= post.title %>">
          <% } %>
          <h2>
            <%= post.title %>
          </h2>
          <p class="journal__date">
            <%= post.published_date %>
              <% if (post.zone_name) { %> &middot; <a href="/zones/<%= post.zone_slug %>">
                  <%= post.zone_name %>
                </a>
                <% } %>
          </p>
          <p>
            <%= post.body %>
          </p>
          <% if (post.image_credit) { %>
            <p class="journal__credit"><%= post.image_credit %></p>
          <% } %>
        </article>
        <% }) %>
    </main>

    <%- include('partials/footer') %>
